---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { CASE_STUDIES } from "@/data/resume";
import { ArrowRight } from "lucide-react";
---

<Layout title="Clinical AI" description="Case studies in medication safety, longitudinal clinical data, and hospital-system integration.">
  <main>
    <PageHeader eyebrow="Clinical AI" title="Systems designed for clinical reality." description="Selected work translating clinical requirements into auditable, fault-tolerant systems—from evidence retrieval and inference to hospital integration and production monitoring." />
    <div class="space-y-5">
      {CASE_STUDIES.map((study, index) => (
        <a href={`/clinical-ai/${study.slug}`} class="surface-card group grid gap-6 p-6 transition-all hover:border-primary/35 sm:p-8 md:grid-cols-[5rem_1fr_auto] md:items-start">
          <span class="font-mono text-sm text-primary">0{index + 1}</span>
          <div><p class="text-xs font-medium uppercase tracking-[0.15em] text-muted-foreground">{study.eyebrow}</p><h2 class="mt-2 text-2xl font-semibold tracking-tight">{study.title}</h2><p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">{study.summary}</p><div class="mt-5 flex flex-wrap gap-2">{study.tags.map((tag) => <span class="pill">{tag}</span>)}</div></div>
          <ArrowRight className="mt-1 size-5 text-muted-foreground transition-transform group-hover:translate-x-1 group-hover:text-primary" />
        </a>
      ))}
    </div>
  </main>
</Layout>
