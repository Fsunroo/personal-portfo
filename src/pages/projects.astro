---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { PROJECTS } from "@/data/resume";
import { ArrowUpRight } from "lucide-react";
---
<Layout title="Projects" description="Selected clinical AI, computational biology, medical imaging, and scientific software projects.">
  <main>
    <PageHeader eyebrow="Selected projects" title="Research code and working systems." description="A curated selection from my public and applied work—not an exhaustive mirror of every repository. The emphasis is on clinical relevance, technical depth, and reproducibility." />
    <div class="grid gap-4 md:grid-cols-2">
      {PROJECTS.map((project, index) => (
        <article class="surface-card flex min-h-72 flex-col p-6 sm:p-7">
          <div class="mb-8 flex items-center justify-between"><span class="font-mono text-xs text-primary">0{index + 1}</span>{project.href && <a href={project.href} target="_blank" aria-label={`Open ${project.title} on GitHub`} class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground">GitHub <ArrowUpRight className="size-3.5" /></a>}</div>
          <p class="text-xs font-medium uppercase tracking-[0.14em] text-muted-foreground">{project.category}</p><h2 class="mt-2 text-xl font-semibold tracking-tight">{project.title}</h2><p class="mt-3 leading-relaxed text-muted-foreground">{project.description}</p>
          <div class="mt-auto pt-6"><div class="flex flex-wrap gap-2">{project.tags.map((tag) => <span class="pill">{tag}</span>)}</div>{project.links && <div class="mt-4 flex flex-wrap gap-2">{project.links.map((link) => <a class="text-link" href={link.href} target="_blank">{link.label}<ArrowUpRight className="size-3.5" /></a>)}</div>}</div>
        </article>
      ))}
    </div>
  </main>
</Layout>
